{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "swagger:validate": "swagger-cli validate docs/swagger.yaml",
    "swagger:generate": "swagger-cli bundle docs/swagger.yaml -o docs/swagger-bundled.yaml",
    "swagger:serve": "swagger-ui-watcher docs/swagger.yaml",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest tests/auth",
    "test:sessions": "jest tests/sessions",
    "test:enrolments": "jest tests/enrolments",
    "test:certificates": "jest tests/certificates",
    "test:trainers": "jest tests/trainers",
    "test:admin": "jest tests/admin"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 10000,
    "verbose": true,
    "collectCoverageFrom": [
      "modules/**/*.js",
      "shared/validators/**/*.js",
      "middleware/**/*.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.6.1",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "fs-extra": "^11.3.5",
    "handlebars": "^4.7.9",
    "http-errors": "~1.6.3",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "swagger-cli": "^4.0.4",
    "swagger-ui-watcher": "^2.1.13",
    "yamljs": "^0.3.0"
  }
}
