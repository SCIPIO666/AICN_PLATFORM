{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "swagger:validate": "swagger-cli validate docs/swagger.yaml",
    "swagger:generate": "swagger-cli bundle docs/swagger.yaml -o docs/swagger-bundled.yaml",
    "swagger:serve": "swagger-ui-watcher docs/swagger.yaml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:auth": "jest tests/auth.test.js",
    "test:sessions": "jest tests/sessions.test.js",
    "test:enrolments": "jest tests/enrolments.test.js",
    "test:certificates": "jest tests/certificates.test.js",
    "test:trainers": "jest tests/trainers.test.js",
    "test:admin": "jest tests/admin.test.js",
    "test:all": "npm run test:auth && npm run test:sessions && npm run test:enrolments && npm run test:certificates && npm run test:trainers && npm run test:admin",
    "test:email": "jest tests/utils/emailService.test.js",
    "test:pdf": "jest tests/utils/pdfGenerator.test.js",
    "test:certificates:integration": "jest tests/integration/certificateWithEmail.test.js",
    "email:test": "node scripts/testEmail.js",
    "pdf:test": "node scripts/testPDF.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.6.1",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "swagger-cli": "^4.0.4",
    "swagger-ui-watcher": "^2.1.13",
    "yamljs": "^0.3.0"
  }
}
