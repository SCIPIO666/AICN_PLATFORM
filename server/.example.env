DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587 # 587 = TLS (STARTTLS) | 465 = SSL | 25 = unencrypted (avoid)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here # NOT your account password — see Step 2a
EMAIL_SECURE=false # true only if port 465

# --- Sender identity ---
EMAIL_FROM="Your Name <you@gmail.com>"

# How to get App Password: Google Account > Security > 2FA > App Passwords

# Alternative with other providers
# EMAIL_HOST=smtp.mailtrap.io (for testing)
# EMAIL_USER=your-test-user
# EMAIL_PASS=your-test-password
