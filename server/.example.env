PORT=3000

# db
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"
# auth
JWT_SECRET= your jwt secret
PRODUCTION_URL= your production url

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587     # 587 = TLS (STARTTLS) | 465 = SSL | 25 = unencrypted (avoid)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@aicn.com

# Frontend URL for verification links
FRONTEND_URL=http://localhost:3000

# Development email (ethereal)
ETHEREAL_USER=test@ethereal.com
ETHEREAL_PASS=test123

# Puppeteer cache (optional)
PUPPETEER_CACHE_DIR=./.cache/puppeteer